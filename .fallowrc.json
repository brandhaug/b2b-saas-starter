{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "rules": {
    "circular-dependencies": "error"
  },
  "entry": ["alchemy.run.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@b2b-saas-starter/config",
    "@b2b-saas-starter/db",
    "@base-ui/react",
    "@effect/language-service",
    // Satisfies alchemy's peer dependency for its bun runtime path; the CLI
    // loads it dynamically at deploy time, so no source file imports it.
    "@effect/platform-bun",
    // Email preview server requirement: `email dev` prompts to install this
    // unless it is present; the preview loads it dynamically, so no source
    // file imports it.
    "@react-email/ui",
    "@tailwindcss/typography",
    "babel-plugin-react-compiler",
    "class-variance-authority",
    "cmdk",
    "eslint-plugin-better-tailwindcss",
    // Root-level deploy/seed tooling: alchemy.run.ts and scripts/seed.ts are
    // infrastructure entries, not production runtime.
    "alchemy",
    "effect",
    "shadcn",
    "sonner",
    "tw-animate-css",
    "ultracite"
  ],
  // apps/web/src/components/ui is vendored shadcn output: every primitive stays
  // exported even when a given screen uses only some of them, and its deps
  // (@base-ui/react, cva, cmdk, sonner) are consumed only from there.
  "ignorePatterns": [
    "apps/web/src/index.css",
    "apps/web/src/components/ui/**",
    "scripts/seed.ts"
  ],
  "dynamicallyLoaded": [
    "apps/web/content/blog/*.mdx",
    "apps/web/content/docs/**/*.mdx",
    "apps/web/src/lib/cloudflare-workers-shim.ts",
    "apps/web/src/lib/cloudflare-workers-shim-dev.ts"
  ],
  "resolve": {
    "conditions": ["style"]
  },
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "syntactic",
        "semantic_schema_version": 1,
        "capabilities": [],
        "project_config_hash": "",
        "backend_family": "",
        "completeness": "complete"
      },
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
