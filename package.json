      "@effect/vitest": "4.0.0-rc.112",
      "@fontsource-variable/fraunces": "5.3.0",
      "@fontsource-variable/geist": "5.3.0",
      "@fontsource-variable/geist-mono": "5.3.0",
      "@mdx-js/rollup": "3.1.1",
      "@modelcontextprotocol/client": "2.0.0",
      "@modelcontextprotocol/sdk": "1.30.0",
      "@modelcontextprotocol/server": "2.0.0",
      "@oxlint/plugins": "1.80.0",
      "@playwright/test": "1.62.1",
      "@react-email/components": "1.0.12",
      "@react-email/render": "2.1.0",
      "@react-email/ui": "6.9.3",
      "@rolldown/plugin-babel": "0.2.3",
      "@sentry/cloudflare": "10.72.0",
      "@sentry/react": "10.71.0",
      "@storybook/react-vite": "10.5.10",
      "@tailwindcss/typography": "0.5.20",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/devtools-vite": "0.8.5",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-query": "5.102.8",
      "@tanstack/react-router": "1.170.32",
      "@tanstack/react-router-devtools": "1.167.1",
      "@tanstack/react-router-ssr-query": "1.167.2",
      "@tanstack/react-start": "1.168.49",
      "@tanstack/react-table": "9.2.3",
      "@testing-library/dom": "10.4.1",
      "@testing-library/react": "16.3.3",
      "@types/babel__core": "7.20.5",
      "@types/mdx": "2.0.14",
      "@types/node": "26.4.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "@vitejs/plugin-react": "6.1.1",
      "@vitest/coverage-v8": "4.1.11",
      "agents": "0.21.0",
      "alchemy": "2.0.0-beta.74",
      "babel-plugin-react-compiler": "1.0.0",
      "better-auth": "1.7.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cmdk": "1.1.1",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "effect": "4.0.0-rc.112",
      "effectful-better-auth": "0.3.1",
      "eslint-plugin-better-tailwindcss": "4.7.0",
      "jsdom": "30.0.1",
      "lucide-react": "1.34.0",
      "mermaid": "11.17.2",
      "oxlint": "1.80.0",
      "oxlint-plugin-effect": "0.11.0",
      "oxlint-plugin-react-doctor": "0.9.12",
      "posthog-js": "1.421.1",
      "posthog-node": "5.51.4",
      "qrcode.react": "^4.2.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-email": "6.9.3",
      "recharts": "3.10.1",
      "rehype-pretty-code": "0.14.5",
      "rehype-slug": "6.0.0",
      "remark-frontmatter": "5.0.0",
      "remark-gfm": "4.0.1",
      "remark-mdx-frontmatter": "5.2.0",
      "shadcn": "4.19.0",
      "sonner": "2.0.8",
      "storybook": "10.5.10",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "ultracite": "7.10.7",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vitest": "4.1.11",
      "wrangler": "4.127.0",
      "zod": "4.4.3",
      "vite-plus": "0.3.0"
