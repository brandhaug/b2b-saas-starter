{
  "name": "b2b-saas-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-first B2B SaaS starter monorepo with TanStack Start, Effect v4, Drizzle D1, Better Auth, and Alchemy.",
  "homepage": "https://github.com/brandhaug/b2b-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/brandhaug/b2b-saas-starter/issues"
  },
  "license": "MIT",
  "author": "Martin Brandhaug <martin@brandhaug.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/b2b-saas-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "pnpm -C apps/web dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "lint": "vp lint --type-aware --ignore-pattern '.context/**'",
    "lint:fix": "vp lint --type-aware --ignore-pattern '.context/**' --fix",
    "dead-code": "fallow dead-code --fail-on-regression",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run dead-code && pnpm run test",
    "check:fix": "pnpm run lint:fix && pnpm run format",
    "db:generate": "pnpm -C packages/db db:generate",
    "db:migrate:local": "pnpm -C packages/db db:migrate:local",
    "db:migrate:remote": "pnpm -C packages/db db:migrate:remote",
    "db:seed": "node scripts/seed.ts",
    "deploy": "alchemy deploy --stage prod --yes",
    "destroy": "alchemy destroy --stage prod",
    "deploy:stage": "alchemy deploy --yes --stage \"${ALCHEMY_STAGE:?set ALCHEMY_STAGE, e.g. pr-42}\"",
    "destroy:stage": "alchemy destroy --yes --stage \"${ALCHEMY_STAGE:?set ALCHEMY_STAGE, e.g. pr-42}\"",
    "db:seed:stage": "node scripts/seed.ts --remote --database=\"b2b-saas-starter-${ALCHEMY_STAGE:?set ALCHEMY_STAGE, e.g. pr-42}\"",
    "prepare": "command -v vp >/dev/null 2>&1 && vp config --no-agent || true",
    "infra:wrangler": "node infra/write-wrangler.ts && vp fmt --write apps/api/wrangler.jsonc apps/background/wrangler.jsonc apps/web/wrangler.jsonc"
  },
  "dependencies": {
    "@b2b-saas-starter/capabilities": "workspace:*",
    "@b2b-saas-starter/db": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "oxlint-plugin-effect": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "shadcn": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
