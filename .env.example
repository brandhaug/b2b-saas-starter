# Auth (web). The secret below is a dev-only placeholder — generate your own
# for any real deployment (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-only-secret-3f8a1c9e57b24d6f8e0a4c7b9d2f16e8
BETTER_AUTH_URL=http://localhost:3071
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3071

# Optional modules (inactive when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TEAM=
# Optional operator-provisioned Enterprise subscription price; no self-checkout.
STRIPE_PRICE_ID_ENTERPRISE=
SENTRY_DSN=
# Optional recovery evidence. When configured, use an HTTPS append-only service
# outside the Cloudflare account and its bearer token.
SECURITY_EVIDENCE_URL=
SECURITY_EVIDENCE_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
CLOUDFLARE_EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Social sign-in (inactive when unset — one half without the other stays off).
# Callback URLs: {BETTER_AUTH_URL}/api/auth/callback/{github,google}
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKERS_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# Workspace data export (ADR 0055). Set to `true` to provision the export
# bucket + queue at deploy time (alchemy names both per stage); off, workspace
# settings explains that exports are not configured. API_PUBLIC_URL is where
# signed download links point (the API worker); unset = http://localhost:8787.
WORKSPACE_EXPORTS_ENABLED=
API_PUBLIC_URL=

# Public support destinations (invalid email/URLs stay hidden).
SUPPORT_EMAIL=
SUPPORT_HELPDESK_URL=
SUPPORT_HELP_CENTER_URL=

# MCP OAuth (ADR 0054). The API worker's /mcp URL access tokens are bound to,
# and the web worker's issuer URL the API worker trusts tokens from. Locally
# both default so the consent flow works with nothing configured; on the API
# worker, unsetting MCP_OAUTH_ISSUER makes /mcp take API Tokens only.
MCP_RESOURCE_URL=http://localhost:8787/mcp
MCP_OAUTH_ISSUER=http://localhost:3071/api/auth

# OpenTelemetry export (traces, metrics, and the canonical log records).
# Unset = wide events go to the console / Cloudflare Workers Logs only.
# Point at a collector's OTLP/HTTP port, e.g. http://localhost:4318 locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated `key=value` pairs, per the OTel spec — usually a vendor token.
OTEL_EXPORTER_OTLP_HEADERS=
# Resource + wide-event identity. In CI, set these from the build.
# Leave ENVIRONMENT empty for local dev (`pnpm run dev`): setting it to any
# non-production value marks this process as a deployment for the startup
# env audit, which then flags the local placeholder auth URL. Unset, the
# logger falls back to NODE_ENV.
SERVICE_VERSION=
GIT_COMMIT_SHA=
ENVIRONMENT=
MAINTENANCE_MODE=

# Retention policy overrides (optional; safe preview mode is the default).
# Destructive cleanup also requires explicit recovery verification and an
# operator-approved policy digest. RETENTION_DATABASE_TARGET is supplied by
# the production deployment and should remain unset locally.
RETENTION_CLEANUP_ENABLED=
RETENTION_RECOVERY_VERIFIED=
RETENTION_AUDIT_DAYS=
RETENTION_NOTIFICATION_DAYS=
RETENTION_INVITATION_DAYS=
RETENTION_TOKEN_DAYS=
RETENTION_EXPORT_DAYS=
RETENTION_BILLING_DAYS=
RETENTION_EMAIL_DAYS=
RETENTION_UNRESOLVED_EMAIL_DAYS=
RETENTION_BATCH_SIZE=
RETENTION_WORK_BUDGET=
RETENTION_POLICY_APPROVAL_DIGEST=
RETENTION_PREVIEW_DIGEST=
RETENTION_RECOVERY_EVIDENCE=
RETENTION_POLICY_VERSION=
RETENTION_POLICY_TARGET=
RETENTION_DATABASE_TARGET=

# Cloudflare D1 remote access (db:generate / db:migrate:remote via drizzle-kit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
