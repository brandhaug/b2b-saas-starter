# Auth (web). The secret below is a dev-only placeholder — generate your own
# for any real deployment (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-only-secret-3f8a1c9e57b24d6f8e0a4c7b9d2f16e8
BETTER_AUTH_URL=http://localhost:3071
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3071

# Optional modules (inactive when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TEAM=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
CLOUDFLARE_EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WORKERS_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# Workspace data export (ADR 0055). Set the R2 bucket name to provision the
# export bucket + queue at deploy time; unset, workspace settings explains that
# exports are not configured. API_PUBLIC_URL is where signed download links
# point (the API worker); unset = http://localhost:8787.
WORKSPACE_EXPORT_BUCKET=
API_PUBLIC_URL=

# OpenTelemetry export (traces, metrics, and the canonical log records).
# Unset = wide events go to the console / Cloudflare Workers Logs only.
# Point at a collector's OTLP/HTTP port, e.g. http://localhost:4318 locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated `key=value` pairs, per the OTel spec — usually a vendor token.
OTEL_EXPORTER_OTLP_HEADERS=
# Resource + wide-event identity. In CI, set these from the build.
# Leave ENVIRONMENT empty for local dev (`bun run dev`): setting it to any
# non-production value marks this process as a deployment for the startup
# env audit, which then flags the local placeholder auth URL. Unset, the
# logger falls back to NODE_ENV.
SERVICE_VERSION=
GIT_COMMIT_SHA=
ENVIRONMENT=

# Cloudflare D1 remote access (db:generate / db:migrate:remote via drizzle-kit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
