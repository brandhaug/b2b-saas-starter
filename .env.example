# Local Worker origins
ENVIRONMENT=development
PUBLIC_SITE_ORIGIN=http://localhost:3071
MERCHANT_APP_ORIGIN=http://localhost:3072
OPERATIONS_APP_ORIGIN=http://localhost:3076
PLATFORM_API_ORIGIN=http://localhost:8787

# Dedicated keyed digests for Customer Directory replay/import metadata.
# Required for deploy and shared by every Worker connected to the primary D1.
CUSTOMER_DIRECTORY_FINGERPRINT_KEY=replace-with-a-distinct-strong-directory-key

# Merchant App authentication (required for deploy; local values may differ)
MERCHANT_AUTH_SECRET=replace-with-a-strong-local-secret
MERCHANT_AUTH_URL=http://localhost:3072
MERCHANT_AUTH_TRUSTED_ORIGINS=http://localhost:3072,http://hassans-macbook-pro.tail8c0b7c.ts.net:3072

# Dedicated Operations auth realm. Its secret must differ from Merchant Auth.
OPERATIONS_AUTH_SECRET=replace-with-a-distinct-strong-local-operations-secret
OPERATIONS_AUTH_TRUSTED_ORIGINS=http://localhost:3076,http://hassans-macbook-pro.tail8c0b7c.ts.net:3076
OPERATIONS_SECURITY_CONTACT=security@operations.local
# Enables operator@operations.local only for deterministic local development.
OPERATIONS_LOCAL_SEED=enabled
OPERATIONS_RATE_LIMIT_SESSION_READ=120
OPERATIONS_RATE_LIMIT_AUTHENTICATION=10
OPERATIONS_RATE_LIMIT_TOTP=5
OPERATIONS_RATE_LIMIT_SEARCH=30
OPERATIONS_RATE_LIMIT_MANAGEMENT=20
OPERATIONS_RATE_LIMIT_IMPERSONATION_START=10
OPERATIONS_RATE_LIMIT_HANDOFF_EXCHANGE=10
OPERATIONS_RATE_LIMIT_WINDOW_SECONDS=60

# Optional customer identity. Anonymous booking remains complete when unset.
CUSTOMER_AUTH_SECRET=
CUSTOMER_GOOGLE_ENABLED=false
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_CLIENT_SECRET=
CUSTOMER_APPLE_ENABLED=false
CUSTOMER_APPLE_CLIENT_ID=
CUSTOMER_APPLE_CLIENT_SECRET=

# Confirmation token keyring. JSON maps key IDs to secrets; rotate by adding a
# key, changing the current ID, then retaining old keys until tokens expire.
CONFIRMATION_SIGNING_KEYS={"local-current":"replace-with-a-strong-local-confirmation-key"}
CONFIRMATION_CURRENT_KEY_ID=local-current

# Optional Operational Messaging destination protection. Both secrets must be
# configured together; when absent, Booking remains available and mobile intent
# production is disabled. Rotate by incrementing the non-secret key version.
OPERATIONAL_MESSAGING_DESTINATION_ENCRYPTION_KEY=
OPERATIONAL_MESSAGING_DESTINATION_FINGERPRINT_KEY=
OPERATIONAL_MESSAGING_DESTINATION_KEY_VERSION=1
SMSO_API_KEY=
SMSO_SENDER_ID=
SMSO_CALLBACK_URL=
SMSO_CALLBACK_PATH_SECRET=
SMSO_PROVIDER_REFERENCE_ENCRYPTION_KEY=
SMSO_PROVIDER_REFERENCE_FINGERPRINT_KEY=
SMSO_PROVIDER_REFERENCE_KEY_VERSION=1
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_PROVIDER_ACCOUNT_KEY=platform-meta
META_WHATSAPP_REFERENCE_ENCRYPTION_KEY=
META_WHATSAPP_REFERENCE_FINGERPRINT_KEY=
META_WHATSAPP_REFERENCE_KEY_VERSION=1

# Optional Stripe settlement. When unset, online methods remain disabled and
# Pay In Person continues without a Payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER_METHODS=card,apple_pay,google_pay,cash_app_pay,klarna

# Optional outbound email. When unset, confirmation still succeeds and durable
# outbox work remains recoverable.
CLOUDFLARE_EMAIL_FROM=

# Optional observability/AI modules (inactive when unset)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
WORKERS_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=

# Cloudflare remote migration/deployment credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
