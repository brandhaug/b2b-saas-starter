// The repo-root TypeScript that belongs to no workspace: the deploy
// entrypoint, the operator CLIs, the CI scripts, and the root tool configs.
// `vp run -r typecheck` walks workspaces, so without this project these files
// were the only TypeScript in the repo nothing type-checked. `test:scripts`
// runs it before the script tests, so `pnpm run check` covers it.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Node-only tooling uses Map upsert from Node 26. The pinned compilers
    // expose it through ESNext; app packages retain their shared runtime baseline.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "alchemy.run.ts",
    "alchemy.bootstrap.ts",
    "alchemy.email.ts",
    "alchemy.github.ts",
    "alchemy.monitoring.ts",
    "alchemy.backup.ts",
    "alchemy.dns.ts",
    "deployment.config.ts",
    "lint.config.ts",
    "vite.config.ts",
    "scripts/**/*.ts",
    ".github/scripts/**/*.ts"
  ]
}
