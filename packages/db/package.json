{
  "name": "@b2b-saas-starter/db",
  "private": true,
  "type": "module",
  "exports": {
    "./ids": "./src/ids.ts",
    "./identity-values": "./src/identity-values.ts",
    "./enums": "./src/enums.ts",
    "./schema": "./src/schema.ts",
    "./service": "./src/service.ts",
    "./testing": "./src/testing.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/workspaces": "./src/schema/workspaces.ts",
    "./schema/developer-platform": "./src/schema/developer-platform.ts",
    "./schema/notifications": "./src/schema/notifications.ts",
    "./schema/governance": "./src/schema/governance.ts",
    "./schema/oauth": "./src/schema/oauth.ts",
    "./schema/billing": "./src/schema/billing.ts",
    "./schema/email-delivery": "./src/schema/email-delivery.ts",
    "./schema/assistant": "./src/schema/assistant.ts",
    "./schema/json": "./src/schema/json.ts"
  },
  "scripts": {
    "build": "tsrs --noEmit",
    "typecheck": "tsrs --noEmit",
    "test": "vp test run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate.ts",
    "db:migrate:remote": "node scripts/migrate.ts --remote"
  },
  "dependencies": {
    "@b2b-saas-starter/failure": "workspace:*",
    "@effect/sql-d1": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/sql": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
