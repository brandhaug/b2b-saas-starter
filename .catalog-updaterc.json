{
  "$schema": "https://raw.githubusercontent.com/brandhaug/catalog-update-action/master/schema.json",
  "defaultBranch": "master",
  "maxOpenPrs": 20,
  "concurrency": 10,
  "minReleaseAgeDays": 3,
  "autoMerge": { "enabled": true, "mergeMethod": "squash" },
  "groups": [
    { "name": "react", "patterns": ["react", "react-dom"] },
    { "name": "better-auth", "patterns": ["better-auth", "@better-auth/*"] },
    { "name": "drizzle", "patterns": ["drizzle-orm", "drizzle-kit"] },
    { "name": "react-email", "patterns": ["react-email", "@react-email/*"] },
    { "name": "sentry", "patterns": ["@sentry/*"] },
    {
      "name": "tanstack-router",
      "patterns": [
        "@tanstack/react-router*",
        "@tanstack/router*",
        "@tanstack/react-start"
      ]
    },
    { "name": "tanstack", "patterns": ["@tanstack/*"] },
    { "name": "effect", "patterns": ["effect", "@effect/*"] },
    {
      "name": "tailwind",
      "patterns": ["tailwindcss", "@tailwindcss/*", "tailwind-merge", "tw-animate-css"]
    },
    { "name": "testing-library", "patterns": ["@testing-library/*"] },
    {
      "name": "mdx",
      "patterns": ["@mdx-js/*", "remark-*", "rehype-*", "@types/mdx"]
    },
    { "name": "all-patch-updates", "patterns": ["*"], "updateTypes": ["patch"] }
  ],
  "ignore": [
    { "pattern": "vite" },
    { "pattern": "@vitejs/*" },
    { "pattern": "vite-plus" },
    { "pattern": "vitest" },
    { "pattern": "@vitest/*" },
    { "pattern": "oxlint" },
    { "pattern": "oxlint-*" },
    { "pattern": "@oxlint/*" },
    { "pattern": "oxfmt" }
  ]
}
