{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2b-saas-starter-background",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-05-16",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_SITE_ORIGIN": "http://localhost:3071",
    "CONFIRMATION_CURRENT_KEY_ID": "local-v1",
    "CONFIRMATION_SIGNING_KEYS": "{\"local-v1\":\"replace-before-production-confirmation-key\"}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b-saas-starter",
      "database_id": "placeholder"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BOOKING_EVENTS_QUEUE",
        "queue": "b2b-saas-starter-booking-events"
      }
    ],
    "consumers": [
      {
        "queue": "b2b-saas-starter-booking-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "max_concurrency": 1,
        "retry_delay": 30,
        "dead_letter_queue": "b2b-saas-starter-booking-events-dead-letter"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
