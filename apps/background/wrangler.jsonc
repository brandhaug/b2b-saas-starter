// Generated by `pnpm run infra:wrangler` from infra/bindings.ts and
// infra/write-wrangler.ts. Do not edit — change the spec and re-run, or CI's
// `git diff --exit-code` will fail. Alchemy reads the same specs, so a worker
// cannot drift from its production deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2b-saas-starter-background",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b-saas-starter",
      "database_id": "placeholder"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "b2b-saas-starter-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "b2b-saas-starter-webhooks",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "max_concurrency": 4,
        "retry_delay": 30,
        "dead_letter_queue": "b2b-saas-starter-webhooks-dlq"
      },
      {
        "queue": "b2b-saas-starter-webhooks-dlq",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 1,
        "max_concurrency": 1
      },
      {
        "queue": "b2b-saas-starter-workspace-exports",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "b2b-saas-starter-billing",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "WORKSPACE_EXPORT_BUCKET",
      "bucket_name": "b2b-saas-starter-workspace-exports"
    }
  ]
}
