{
  "name": "assistant-effect-prototype",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AssistantPrototype",
        "class_name": "AssistantPrototype"
      }
    ]
  },
  "migrations": [
    {
      "tag": "prototype-v1",
      "new_sqlite_classes": ["AssistantPrototype"]
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
