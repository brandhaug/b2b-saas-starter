// Generated by `pnpm run infra:wrangler` from infra/bindings.ts and
// infra/write-wrangler.ts. Do not edit — change the spec and re-run, or CI's
// `git diff --exit-code` will fail. Alchemy reads the same specs, so a worker
// cannot drift from its production deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2b-saas-starter-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b-saas-starter",
      "database_id": "placeholder"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "BILLING_QUEUE",
        "queue": "b2b-saas-starter-billing"
      },
      {
        "binding": "WORKSPACE_EXPORT_QUEUE",
        "queue": "b2b-saas-starter-workspace-exports"
      },
      {
        "binding": "NOTIFICATION_EMAIL_QUEUE",
        "queue": "b2b-saas-starter-notification-emails"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "WORKSPACE_EXPORT_BUCKET",
      "bucket_name": "b2b-saas-starter-workspace-exports"
    }
  ],
  "vars": {
    "WORKERS_AI_ENABLED": "false",
    "MCP_RESOURCE_URL": "http://localhost:8787/mcp"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER_AUTH_READ",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": {
          "limit": 60,
          "period": 60
        }
      },
      {
        "name": "RATE_LIMITER_AUTH_WRITE",
        "type": "ratelimit",
        "namespace_id": "2002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      },
      {
        "name": "RATE_LIMITER_AUTH_SIGN_IN",
        "type": "ratelimit",
        "namespace_id": "2003",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
