    "@b2b-saas-starter/logger": "workspace:*",
    "@b2b-saas-starter/rate-limit": "workspace:*",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/sso": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
