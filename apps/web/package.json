{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:generate": "node scripts/generate-agent-exports.mjs",
    "docs:check": "node scripts/generate-agent-exports.mjs --check && node --test scripts/agent-exports.verify.mjs",
    "dev": "B2B_STARTER_USE_WORKERS_SHIM=1 vp dev --port 3071",
    "build": "B2B_STARTER_USE_WORKERS_SHIM=1 vp build",
    "build:e2e": "vp build --mode e2e",
    "serve:e2e": "vp preview --mode e2e",
    "serve": "vp preview --port 3071",
    "typecheck": "tsrs --noEmit",
    "test": "vp test run && pnpm run test:lifecycle && pnpm run test:docs-runtime",
    "test:lifecycle": "vp test run --config vitest.lifecycle.config.ts",
    "test:docs-runtime": "vp build --config vite.docs-runtime.config.ts && vp test run --config vitest.docs-runtime.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@b2b-saas-starter/ai": "workspace:*",
