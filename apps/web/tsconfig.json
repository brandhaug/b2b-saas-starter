{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "virtual:docs-search": ["./src/docs-search-index.d.ts"]
    },
    "types": [
      "vite/client",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin",
      "@types/node"
    ]
  },
  "include": [
    "src",
    "content",
    "scripts/*.ts",
    "vite.config.ts",
    "vitest.lifecycle.config.ts",
    "test/assistant/lifecycle*.ts",
    "playwright.config.ts"
  ]
}
