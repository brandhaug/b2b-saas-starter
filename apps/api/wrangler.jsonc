// Generated by `pnpm run infra:wrangler` from infra/bindings.ts and
// infra/write-wrangler.ts. Do not edit — change the spec and re-run, or CI's
// `git diff --exit-code` will fail. Alchemy reads the same specs, so a worker
// cannot drift from its production deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2b-saas-starter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b-saas-starter",
      "database_id": "placeholder"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "b2b-saas-starter-webhooks"
      },
      {
        "binding": "WORKSPACE_EXPORT_QUEUE",
        "queue": "b2b-saas-starter-workspace-exports"
      },
      {
        "binding": "NOTIFICATION_EMAIL_QUEUE",
        "queue": "b2b-saas-starter-notification-emails"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "WORKSPACE_EXPORT_BUCKET",
      "bucket_name": "b2b-saas-starter-workspace-exports"
    }
  ],
  "vars": {
    "WORKERS_AI_ENABLED": "false",
    "CLOUDFLARE_EMAIL_FROM": "noreply@example.com"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER_REST",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 60,
          "period": 60
        }
      },
      {
        "name": "RATE_LIMITER_REST_WRITE",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      },
      {
        "name": "RATE_LIMITER_ASSISTANT",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": {
          "limit": 20,
          "period": 60
        }
      },
      {
        "name": "RATE_LIMITER_MCP",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ]
  }
}
