+import { Effect } from 'effect'
+import { WorkspaceNotes } from '@b2b-saas-starter/capabilities/notes/workspace-notes'
+import { runWorkspaceCapabilities } from '../capabilities'
+import { requireRequestSession } from './auth'
+import { requireWorkspacePermission } from './authorize'
+import { workspacePage } from './page-frame'
+import { type WorkspaceNotesInput, type AddWorkspaceNoteInput } from './workspace-notes'
+
+export async function loadWorkspaceNotesHandler(input: WorkspaceNotesInput) {
+  const session = await requireRequestSession()
+  return runWorkspaceCapabilities(
+    input.workspaceSlug,
+    workspacePage({ workspaceNote: ['list'] }, () =>
+      Effect.gen(function* () {
+        const notes = yield* WorkspaceNotes
+        return { notes: (yield* notes.listPage({ limit: 30 })).items }
+      })
+    ),
+    { userId: session.user.id }
+  )
+}
+export async function addWorkspaceNoteHandler(input: AddWorkspaceNoteInput) {
+  const session = await requireRequestSession()
+  return runWorkspaceCapabilities(
+    input.workspaceSlug,
+    Effect.gen(function* () {
+      yield* requireWorkspacePermission({ workspaceNote: ['create'] })
+      const notes = yield* WorkspaceNotes
+      return yield* notes.create({ body: input.body })
+    }),
+    { userId: session.user.id }
+  )
+}
