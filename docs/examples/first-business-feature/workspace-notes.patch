@@ -0,0 +1,61 @@
+import { expect, test } from '@playwright/test'
+import { signInWithPassword } from './authentication'
+
+// Failure cases: anonymous access, outsider disclosure, writes lost on reload.
+test('member creates a persistent note and an outsider cannot read it', async ({
+  page,
+  browser,
+  baseURL
+}, testInfo) => {
+  await page.goto('/workspaces/starter-lab/notes')
+  await expect(page).toHaveURL(/sign-in/)
+  await signInWithPassword(
+    page,
+    'engineer@example.com',
+    '/workspaces/starter-lab/notes'
+  )
+  await page.locator('form[data-hydrated="true"]').waitFor()
+  const body = `Tutorial note ${Date.now()}`
+  await page.getByLabel('Note text').fill(body)
+  const mutationRequest = page.waitForRequest(
+    (request) =>
+      request.method() === 'POST' &&
+      request.url().includes('_serverFn') &&
+      request.postData()?.includes(body) === true
+  )
+  await page.getByRole('button', { name: 'Add note', exact: true }).click()
+  const savedRequest = await mutationRequest
+  await expect(page.getByText(body, { exact: true })).toBeVisible({ timeout: 30_000 })
+  await page.reload()
+  await expect(page.getByText(body, { exact: true })).toBeVisible({ timeout: 30_000 })
+  await page.screenshot({
+    path: testInfo.outputPath('persisted-note.png'),
+    fullPage: true
+  })
+  const outsider = await browser.newContext()
+  const other = await outsider.newPage()
+  const signup = await outsider.request.post(`${baseURL}/api/auth/sign-up/email`, {
+    headers: { origin: baseURL ?? 'http://localhost:3104' },
+    data: {
+      name: 'Tutorial outsider',
+      email: `notes-${Date.now()}@example.com`,
+      password: 'outsider-tutorial-password'
+    }
+  })
+  await expect(signup).toBeOK()
+  await other.goto('/workspaces/starter-lab/notes')
+  await expect(other.getByText(body, { exact: true })).toHaveCount(0)
+  await expect(other.getByRole('heading', { name: /not found/i })).toBeVisible()
+  const denied = await outsider.request.post(savedRequest.url(), {
+    headers: {
+      'content-type': savedRequest.headers()['content-type'] ?? 'application/json',
+      origin: baseURL ?? 'http://localhost:3104',
+      'x-tsr-serverfn': 'true'
+    },
+    data: savedRequest.postData()?.replace(body, 'Outsider injection')
+  })
+  expect(await denied.text()).not.toContain('Outsider injection')
+  await page.reload()
+  await expect(page.getByText('Outsider injection', { exact: true })).toHaveCount(0)
+  await outsider.close()
+})
