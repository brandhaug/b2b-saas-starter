diff --git a/apps/api/src/workspace-notes.test.ts b/apps/api/src/workspace-notes.test.ts
new file mode 100644
index 00000000..d41a6496
--- /dev/null
+++ b/apps/api/src/workspace-notes.test.ts
@@ -0,0 +1,139 @@
+import { Effect } from 'effect'
+import { expect, it } from '@effect/vitest'
+import { hashSha256 } from '@b2b-saas-starter/capabilities/crypto'
+import { provisionTestD1 } from '@b2b-saas-starter/db/testing'
+import {
+  SEED_API_TOKEN,
+  SEED_READONLY_API_TOKEN
+} from '@b2b-saas-starter/capabilities/developer-platform/api-token-registry'
+import { buildWebHandler } from './http.ts'
+import { type ApiEnv } from './env.ts'
+
+function application(env: ApiEnv) {
+  return Effect.acquireRelease(
+    Effect.sync(() => buildWebHandler(env)),
+    (app) => Effect.promise(() => app.dispose())
+  )
+}
+function request(slug: string, method: string, token?: string, body?: string) {
+  const headers = new Headers({ 'content-type': 'application/json' })
+  if (token !== undefined) {
+    headers.set('authorization', `Bearer ${token}`)
+  }
+  return new Request(`https://api.test/workspaces/${slug}/notes`, {
+    method,
+    headers,
+    body: body ?? null
+  })
+}
+
+// Failure cases: missing credential; read token mutation; wrong workspace;
+// invalid body; cross-workspace disclosure; lost write after handler recreation.
+it.live(
+  'persists notes through REST and refuses unauthorized requests',
+  () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const database = yield* Effect.acquireRelease(
+          Effect.promise(provisionTestD1),
+          (db) => Effect.promise(() => db.dispose())
+        )
+        yield* Effect.promise(() =>
+          database.d1
+            .prepare(
+              "INSERT INTO workspaces (id, slug, name) VALUES ('wrk_notes', 'notes-lab', 'Notes lab'), ('wrk_other_notes', 'other-notes', 'Other notes')"
+            )
+            .run()
+        )
+        const hash = yield* Effect.promise(() => hashSha256('notes-test-secret'))
+        yield* Effect.promise(() =>
+          database.d1
+            .prepare(
+              "INSERT INTO api_tokens (id, workspace_id, name, token_hash, token_prefix, scopes, created_at) VALUES ('tok_notes', 'wrk_notes', 'Notes', ?, 'notes', ?, '2026-01-01T00:00:00.000Z')"
+            )
+            .bind(hash, '["write"]')
+            .run()
+        )
+        yield* Effect.promise(() =>
+          database.d1
+            .prepare(
+              "INSERT INTO workspace_notes (id, workspace_id, body, created_at) VALUES ('note_other', 'wrk_other_notes', 'Other workspace secret', '2026-01-01T00:00:00.000Z')"
+            )
+            .run()
+        )
+        const first = yield* application({ DB: database.d1 })
+        function send(slug: string, method: string, token?: string, body?: string) {
+          return Effect.promise(() => first.handler(request(slug, method, token, body)))
+        }
+        const anonymous = yield* send('notes-lab', 'GET')
+        expect(anonymous.status).toBe(401)
+        const wrongRead = yield* send('other-notes', 'GET', 'notes-test-secret')
+        expect(wrongRead.status).toBe(403)
+        const wrongWrite = yield* send(
+          'other-notes',
+          'POST',
+          'notes-test-secret',
+          '{"body":"No"}'
+        )
+        expect(wrongWrite.status).toBe(403)
+        const invalid = yield* send(
+          'notes-lab',
+          'POST',
+          'notes-test-secret',
+          '{"body":""}'
+        )
+        expect(invalid.status).toBe(400)
+        const created = yield* send(
+          'notes-lab',
+          'POST',
+          'notes-test-secret',
+          '{"body":"Persistent note"}'
+        )
+        expect(created.status).toBe(200)
+        const second = yield* application({ DB: database.d1 })
+        const read = yield* Effect.promise(() =>
+          second.handler(request('notes-lab', 'GET', 'notes-test-secret'))
+        )
+        const text = yield* Effect.promise(() => read.text())
+        expect(text).toContain('Persistent note')
+        expect(text).not.toContain('Other workspace secret')
+        const rows = yield* Effect.promise(() =>
+          database.d1
+            .prepare('SELECT body FROM workspace_notes WHERE workspace_id = ?')
+            .bind('wrk_notes')
+            .all()
+        )
+        expect(rows.results).toEqual([{ body: 'Persistent note' }])
+        const audit = yield* Effect.promise(() =>
+          database.d1
+            .prepare(
+              "SELECT actor_type FROM audit_events WHERE event_type = 'workspace_note.created'"
+            )
+            .all()
+        )
+        expect(audit.results).toEqual([{ actor_type: 'api_token' }])
+      })
+    ),
+  60_000
+)
+
+it.live('Seed preserves create/list behavior and read scopes cannot create', () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const app = yield* application({})
+      const body = '{"body":"Seed note"}'
+      const refused = yield* Effect.promise(() =>
+        app.handler(request('starter-lab', 'POST', SEED_READONLY_API_TOKEN, body))
+      )
+      expect(refused.status).toBe(403)
+      const created = yield* Effect.promise(() =>
+        app.handler(request('starter-lab', 'POST', SEED_API_TOKEN, body))
+      )
+      expect(created.status).toBe(200)
+      const read = yield* Effect.promise(() =>
+        app.handler(request('starter-lab', 'GET', SEED_READONLY_API_TOKEN))
+      )
+      expect(yield* Effect.promise(() => read.text())).toContain('Seed note')
+    })
+  )
+)
diff --git a/apps/web/e2e/workspace-notes.spec.ts b/apps/web/e2e/workspace-notes.spec.ts
