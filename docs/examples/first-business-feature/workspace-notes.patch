+export type WorkspaceNote = typeof WorkspaceNote.Type
+
+export class WorkspaceNotes extends Context.Service<
+  WorkspaceNotes,
+  {
+    readonly listPage: (
+      input?: ListPageInput
+    ) => Effect.Effect<Page<WorkspaceNote>, CapabilityUnavailable, WorkspaceContext>
+    readonly create: (
+      input: typeof CreateWorkspaceNote.Type
+    ) => Effect.Effect<WorkspaceNote, CapabilityUnavailable, WorkspaceContext>
+  }
+>()('@b2b-saas-starter/capabilities/WorkspaceNotes') {}
+
+function positionOf(note: WorkspaceNote) {
+  return { key: note.createdAt, id: note.id }
+}
+const newNote = Effect.fn('WorkspaceNotes.newNote')(function* (
+  input: typeof CreateWorkspaceNote.Type
+) {
+  return {
+    id: yield* newCapabilityId('note'),
+    body: input.body,
+    createdAt: DateTime.formatIso(yield* DateTime.now)
+  }
+})
+function createdEvent(
+  ctx: WorkspaceContext['Service'],
+  note: WorkspaceNote
+): RecordAuditEventInput {
+  return {
+    workspaceId: ctx.workspace.id,
+    actorUserId: ctx.actor?.userId ?? null,
+    actorType: ctx.actorType,
+    eventType: 'workspace_note.created',
+    targetType: 'workspace_note',
+    targetId: note.id,
+    metadata: {}
+  }
+}
+
+export const SeedWorkspaceNotes = Layer.effect(
+  WorkspaceNotes,
+  Effect.gen(function* () {
+    const audit = yield* AuditEventLog
+    const rows = yield* Ref.make<
+      ReadonlyArray<WorkspaceNote & { readonly workspaceId: string }>
+    >([])
+    return WorkspaceNotes.of({
+      listPage: Effect.fn('WorkspaceNotes.listPage')(function* (input) {
+        const ctx = yield* WorkspaceContext
+        const visible: Array<WorkspaceNote> = []
+        for (const row of yield* Ref.get(rows)) {
+          if (row.workspaceId === ctx.workspace.id) {
+            visible.push({ id: row.id, body: row.body, createdAt: row.createdAt })
+          }
+        }
+        return seedKeysetPage(visible, 'desc', positionOf, input)
+      }),
+      create: Effect.fn('WorkspaceNotes.create')(function* (input) {
+        const ctx = yield* WorkspaceContext
+        const note = yield* newNote(input)
+        yield* audit.record(createdEvent(ctx, note))
+        yield* Ref.update(rows, (all) => [
+          ...all,
+          { ...note, workspaceId: ctx.workspace.id }
+        ])
+        return note
+      })
+    })
+  })
+)
+
+export const LiveWorkspaceNotes = Layer.effect(
+  WorkspaceNotes,
+  Effect.gen(function* () {
+    const db = yield* Database
+    const audit = yield* AuditEventLog
+    const unavailable = orUnavailable('workspace-notes')
+    const mutate = yield* auditedMutations({
+      prepareAuditRecord: audit.prepareRecord,
+      unavailable
+    })
+    return WorkspaceNotes.of({
+      listPage: Effect.fn('WorkspaceNotes.listPage')(function* (input) {
+        const ctx = yield* WorkspaceContext
+        const resume = keysetResume(
+          'desc',
+          { key: workspaceNotes.createdAt, id: workspaceNotes.id },
+          input?.cursor
+        )
+        if (resume.kind === 'empty') {
+          return { items: [], nextCursor: null }
+        }
+        let condition: SQL | undefined
+        if (resume.kind === 'resume') {
+          condition = resume.condition
+        }
+        const limit = clampPageLimit(input?.limit)
+        const rows = yield* unavailable(
+          db
+            .select({
+              id: workspaceNotes.id,
+              body: workspaceNotes.body,
+              createdAt: workspaceNotes.createdAt
+            })
+            .from(workspaceNotes)
+            .where(and(eq(workspaceNotes.workspaceId, ctx.workspace.id), condition))
+            .orderBy(desc(workspaceNotes.createdAt), desc(workspaceNotes.id))
+            .limit(limit + 1)
+        )
+        return cutKeysetPage(rows, limit, positionOf)
+      }),
+      create: Effect.fn('WorkspaceNotes.create')(function* (input) {
+        const ctx = yield* WorkspaceContext
+        const note = yield* newNote(input)
+        yield* mutate({
+          matched: Effect.succeed(true),
+          auditEvent: createdEvent(ctx, note),
+          write: () => [
+            db.insert(workspaceNotes).values({ ...note, workspaceId: ctx.workspace.id })
+          ]
+        })
+        return note
+      })
+    })
+  })
+)
