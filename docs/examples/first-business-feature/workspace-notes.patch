+import { useClientValue } from '@/lib/client-only-value'
+import { useForm } from '@tanstack/react-form'
+import { useServerAction } from '@/hooks/use-server-action'
+import { m } from '@b2b-saas-starter/i18n/messages'
+import { WorkspaceShell } from './workspace-shell'
+import { PageHeader } from './page/page-header'
+import { Panel } from './page/panel'
+import { Button } from './ui/button'
+import { Input } from './ui/input'
+import { Label } from './ui/label'
+import { viewerCan } from '@/lib/permissions'
+import {
+  addWorkspaceNoteServerFn,
+  type WorkspaceNotesPayload
+} from '@/lib/server/workspace-notes'
+
+export function WorkspaceNotesPage({
+  workspaceSlug,
+  data
+}: {
+  readonly workspaceSlug: string
+  readonly data: WorkspaceNotesPayload
+}) {
+  const hydrated = useClientValue(() => true, false)
+  const canCreate = viewerCan(data.viewer, { workspaceNote: ['create'] })
+  const create = useServerAction(addWorkspaceNoteServerFn, {
+    failureMessage: m.notes_failed()
+  })
+  const form = useForm({
+    defaultValues: { body: '' },
+    onSubmit: async ({ value }) => {
+      const outcome = await create.runAsync({
+        data: { workspaceSlug, body: value.body }
+      })
+      if (outcome.ok) {
+        form.reset()
+      }
+    }
+  })
+  return (
+    <WorkspaceShell workspaceSlug={workspaceSlug} viewer={data.viewer}>
+      <PageHeader title={m.notes_title()} description={m.notes_description()} />
+      <Panel>
+        <form
+          data-hydrated={hydrated}
+          className="grid gap-4"
+          onSubmit={(event) => {
+            event.preventDefault()
+            void form.handleSubmit()
+          }}
+        >
+          <form.Field name="body">
+            {(field) => (
+              <div className="grid gap-2">
+                <Label htmlFor="note-body">{m.notes_body()}</Label>
+                <Input
+                  id="note-body"
+                  required
+                  maxLength={500}
+                  value={field.state.value}
+                  onChange={(event) => field.handleChange(event.target.value)}
+                  onBlur={field.handleBlur}
+                  disabled={!hydrated || !canCreate}
+                />
+              </div>
+            )}
+          </form.Field>
+          <form.Subscribe selector={(state) => state.isSubmitting}>
+            {(pending) => (
+              <Button type="submit" disabled={!hydrated || pending || !canCreate}>
+                {pending ? m.notes_saving() : m.notes_add()}
+              </Button>
+            )}
+          </form.Subscribe>
+          {!canCreate && <p>{m.notes_denied()}</p>}
+          {create.error && <p role="alert">{create.error}</p>}
+        </form>
+      </Panel>
+      <Panel title={m.notes_recent()}>
+        {data.notes.length === 0 ? (
+          <p>{m.notes_empty()}</p>
+        ) : (
+          <ul className="grid gap-4">
+            {data.notes.map((note) => (
+              <li key={note.id} className="break-words whitespace-pre-wrap">
+                {note.body}
+              </li>
+            ))}
+          </ul>
+        )}
+      </Panel>
+    </WorkspaceShell>
+  )
+}
